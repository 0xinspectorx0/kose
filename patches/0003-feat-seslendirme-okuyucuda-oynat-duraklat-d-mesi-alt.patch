+        <button id="mini-player-toggle" type="button" aria-label="Seslendirmeyi duraklat veya sürdür"
+          class="w-9 h-9 rounded-full bg-ink-900 text-white flex items-center justify-center flex-shrink-0 active:scale-90 transition-transform">
+          <i data-lucide="pause" id="mini-player-icon" class="w-4 h-4 fill-white"></i>
