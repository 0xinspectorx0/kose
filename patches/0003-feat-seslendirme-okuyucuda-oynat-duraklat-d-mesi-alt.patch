+      // Okuyucu başlığındaki düğme: duruma göre oynat / duraklat simgesi
+      const headerBtn = document.getElementById('listen-article-btn');
+      if (headerBtn) {
+        headerBtn.innerHTML = playing
+          ? `<i data-lucide="pause" class="w-4 h-4"></i>`
+          : `<i data-lucide="play" class="w-4 h-4 fill-current ml-0.5"></i>`;
