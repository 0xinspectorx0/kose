+        headerBtn.setAttribute('aria-label', headerBtn.title);
+      }
+
+      // Mini oynatıcı: okuyucu kapalıyken ve seslendirme sürerken görünür
+      const readerOpen = !articleReader.classList.contains('translate-y-full');
+      const showMini = ttsActive && !readerOpen;
+      if (miniPlayerEl) {
+        miniPlayerEl.classList.toggle('hidden', !showMini);
+        const miniIcon = document.getElementById('mini-player-icon');
+        if (miniIcon) {
+          miniIcon.outerHTML = playing
