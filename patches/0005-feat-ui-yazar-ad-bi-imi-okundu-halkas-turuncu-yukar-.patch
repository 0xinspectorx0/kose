+    // "ahmet hakan" -> "Ahmet HAKAN", "m. serdar kuzuloğlu" -> "M. Serdar KUZULOĞLU"
+    function formatAuthorName(name) {
+      const raw = String(name ?? '').replace(/\s+/g, ' ').trim();
+      if (!raw) return '';
+      const titleCase = w => w.toLocaleLowerCase('tr-TR').replace(/^./, c => c.toLocaleUpperCase('tr-TR'));
+      const parts = raw.split(' ');
+      if (parts.length === 1) return titleCase(raw);
+      const surname = parts[parts.length - 1].toLocaleUpperCase('tr-TR');
+      return `${parts.slice(0, -1).map(titleCase).join(' ')} ${surname}`;
+    }
